# Copy to .env and adjust. Every setting is described in README.md.

# Public name of the notary. Point its DNS A record (and AAAA, with IPv6) at this
# server; Caddy then gets the Let's Encrypt certificate by itself.
NOTARY_DOMAIN=notary.plusprivacy.com

# Shown to people in the extension, next to the certificate this notary saw.
NOTARY_NAME=PlusPrivacy

# Browsers may use the notary only from these origins: the Chrome Web Store item,
# and while testing, an unpacked copy (its ID is in chrome://extensions).
ALLOWED_ORIGINS=chrome-extension://nbanpljakngdndmmekhogfliinegiapb
# Refuse requests that carry no Origin at all. Health checks are not affected.
REQUIRE_ORIGIN=1

# Flood and brute-force protection.
RATE_LIMIT=30
BAN_STRIKES=5
BAN_WINDOW_MINUTES=10
BAN_FIRST_MINUTES=1
BAN_MAX_HOURS=24
GLOBAL_RATE_LIMIT=600
MAX_CONCURRENT=20
CACHE_SECONDS=60

# Keep at 0 so that the log never contains the sites people check.
LOG_HOSTS=0
